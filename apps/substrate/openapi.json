    "/beads/finance/summary": {
      "get": {
        "description": "Server-side roll-up of every ``finance.account`` balance.\n\ncurrent_balance is an encrypted leaf (not a PLAINTEXT_KEY), so the\naggregation can't run in SQL \u2014 we pull the account beads, decrypt\ncontent, and sum ``current_balance`` here. Accounts whose balance is\nmissing or non-numeric are skipped rather than failing the request.",
        "operationId": "finance_summary_beads_finance_summary_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
