# Copy to quickstart/.env. Both values are for this machine only.

# Any string. The console never sees it; mcp-hub injects it.
SUBSTRATE_API_KEY=local-dev-key

# A Fernet key: 32 url-safe base64 bytes. Generate one with
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# or
#   openssl rand -base64 32 | tr '+/' '-_'
# The substrate refuses to start without it. Bead content is encrypted with it;
# lose it and the rows are unreadable.
SUBSTRATE_ENCRYPTION_KEY=
